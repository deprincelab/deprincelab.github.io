#!/bin/bash
#
# build_html: regenerate the tutorial web pages from the Jupyter notebooks.
#
# For each notebook, this script
#   1. converts NAME/NAME.ipynb to NAME/NAME.html with jupyter nbconvert,
#   2. adjusts the nbconvert styling (prompt width, font sizes, equation numbering),
#   3. prepends the Jekyll front matter and table of contents that nbconvert drops.
#
# usage: ./build_html            (all notebooks)
#        ./build_html cis mbpt   (only the named notebooks)
#
# Set JUPYTER to choose which jupyter to use, e.g.
#        JUPYTER=~/.venv/bin/jupyter ./build_html

set -euo pipefail

# run from the directory that holds this script (and ./replace, ./overwrite)
cd "$(dirname "$0")"

JUPYTER=${JUPYTER:-jupyter}

ALL="qm_postulates translation vibration rotation hydrogen variation perturbation hartree_fock second_quantization cis mbpt static_response molecular_integrals"

QM_TOC='<b>Jupyter Notebook Tutorials: Introduction to Quantum Mechanics</b>
<br>
<hr>

1. <a href=../qm_postulates/qm_postulates.html style="color:#e65100;">The Postulates of Quantum Mechanics</a>  <br>
2. <a href=../translation/translation.html style="color:#e65100;">Translational Motion</a>  <br>
3. <a href=../vibration/vibration.html style="color:#e65100;">Vibrational Motion</a>  <br>
4. <a href=../rotation/rotation.html style="color:#e65100;">Angular Momentum, Rotational Motion, and Spin</a> <br>
5. <a href=../hydrogen/hydrogen.html style="color:#e65100;">The Hydrogen Atom</a>  <br>
6. <a href=../variation/variation.html style="color:#e65100;">The Variation Theorem</a>  <br>
7. <a href=../perturbation/perturbation.html style="color:#e65100;">Non-Degenerate Perturbation Theory</a>  <br>

<hr>
'

QC_TOC='<b>Jupyter Notebook Tutorials: Quantum Chemistry</b>
<br>
<hr>

1. <a href=../hartree_fock/hartree_fock.html style="color:#e65100;">Hartree-Fock Theory</a>  <br>
2. <a href=../second_quantization/second_quantization.html style="color:#e65100;">Second Quantization</a>  <br>
3. <a href=../mbpt/mbpt.html style="color:#e65100;">Many-Body Perturbation Theory</a>  <br>
4. <a href=../cis/cis.html style="color:#e65100;">Configuration Interaction with Single Excitations</a>  <br>
5. <a href=../static_response/static_response.html style="color:#e65100;">Static Response Properties</a>  <br>
6. <a href=../molecular_integrals/molecular_integrals.html style="color:#e65100;">Molecular Integrals</a>  <br>

<hr>
'

# page title and table of contents for each notebook
page_info() {
    case $1 in
        qm_postulates)       title="The Postulates of Quantum Mechanics";             toc=$QM_TOC ;;
        translation)         title="Translational Motion";                            toc=$QM_TOC ;;
        vibration)           title="Vibrational Motion";                              toc=$QM_TOC ;;
        rotation)            title="Angular Momentum, Rotational Motion, and Spin";   toc=$QM_TOC ;;
        hydrogen)            title="The Hydrogen Atom";                               toc=$QM_TOC ;;
        variation)           title="The Variation Theorem";                           toc=$QM_TOC ;;
        perturbation)        title="Non-Degenerate Perturbation Theory";              toc=$QM_TOC ;;
        hartree_fock)        title="The Hartree-Fock Self-Consistent Field Procedure"; toc=$QC_TOC ;;
        second_quantization) title="Second Quantization";                             toc=$QC_TOC ;;
        cis)                 title="Configuration Interaction with Single Excitations"; toc=$QC_TOC ;;
        mbpt)                title="Many-Body Perturbation Theory";                   toc=$QC_TOC ;;
        static_response)     title="Static Molecular Response Properties";            toc=$QC_TOC ;;
        molecular_integrals) title="Molecular Integrals";                             toc=$QC_TOC ;;
        *) echo "build_html: unknown notebook '$1'" >&2; exit 1 ;;
    esac
}

names=${*:-$ALL}

for name in $names; do
    page_info "$name"
    file=${name}/${name}.html

    # (1) notebook -> html
    "$JUPYTER" nbconvert "${name}/${name}.ipynb" --to html

    # (2) formatting
    ./replace 'autoNumber: "AMS",' "" "${file}"
    ./replace "--jp-cell-prompt-width: 64px;" "--jp-cell-prompt-width: 0px;" "${file}"
    ./replace "--jp-ui-font-size1: 13px;" "--jp-ui-font-size1: 18px;" "${file}"
    ./replace "--jp-content-font-size1: 14px;" "--jp-content-font-size1: 16px;" "${file}"
    ./replace "--jp-code-font-size: 13px;" "--jp-code-font-size: 12px;" "${file}"
    #./replace "autoplay" "muted autoplay" "${file}"

    # (3) front matter + table of contents (nbconvert output starts at <!DOCTYPE html>)
    tmp=$(mktemp)
    {
        printf -- '---\nlayout: page\nmath: true\ntitle: %s\n---\n\n' "$title"
        printf '%s\n' "$toc"
        cat "${file}"
    } > "$tmp"
    mv "$tmp" "${file}"
    chmod 644 "${file}"

    echo "built ${file}"
done
